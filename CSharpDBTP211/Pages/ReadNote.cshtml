@page
@model CSharpDBTP211.Pages.ReadNoteModel

<h1>Read Notes</h1>

@if (Model.FileNames.Count == 0)
{
    <p>No notes found.</p>
}
else
{
    <h2>Available notes</h2>

    <ul>
        @foreach (var fileName in Model.FileNames)
        {
            <li>
                <a asp-page-handler="View" asp-route-fileName="@fileName">
                    @fileName
                </a>
            </li>
        }
    </ul>
}

@if (Model.Content != null)
{
    <h2>@Model.SelectedFileName</h2>

    <pre>@Model.Content</pre>
}